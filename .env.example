# Supabase (optional – for Community Board)
# Create a project at https://supabase.com and run the SQL in supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Worker (optional – for AI-powered Rules Bot + AI Director)
# Deploy the worker from cloudflare-worker/ directory, then add the URL here
# If not set, the bot will use fallback keyword matching; Director will show a message
# Director endpoint: POST to {URL}/director with { videoIds: ["id1",...] }
NEXT_PUBLIC_CF_WORKER_URL=https://your-worker.your-subdomain.workers.dev

# Ollama (optional – local backup for Llama Vision, e.g. http://localhost:11434)
# Use for local dev or self-hosted vision; not used by deployed app
# NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434

# Only for GitHub Pages project site (e.g. username.github.io/SS-Tournaments)
# GITHUB_REPO=SS-Tournaments

# Stripe (for Pro, Elite, Clan Ultra subscriptions)
# NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_xxx
# NEXT_PUBLIC_STRIPE_ELITE_PRICE_ID=price_xxx
# NEXT_PUBLIC_STRIPE_CLAN_ULTRA_PRICE_ID=price_xxx

# Google AdSense (when set, ad slots use AdSense)
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# For scripts/send-announcement.ts (Gmail mass announcements)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GMAIL_USER=smashhub@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
ANNOUNCEMENT_SUBJECT=SmashHub Announcement
