# Supabase (optional – for Community Board)
# Create a project at https://supabase.com and run the SQL in supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Combine service (optional – for combining 2–8 YouTube clips into one highlight)
# Deploy combine-service/ to Cloud Run, then add the URL here
# If not set, users must upload 2–8 video files to combine
NEXT_PUBLIC_COMBINE_API_URL=https://combine-xxx.run.app
# When VidBridge is verified in Chrome Web Store, set this to the store listing URL
# NEXT_PUBLIC_VIDBRIDGE_CHROME_STORE_URL=https://chrome.google.com/webstore/detail/vidbridge/xxx

# Cloudflare Worker (optional – for AI-powered Rules Bot, Director, and Post AI Assist)
# Deploy the worker from cloudflare-worker/ directory, then add the URL here
# If not set, the bot will use fallback keyword matching; Director will show a message; Post AI Assist disabled
# Director: POST {URL}/director with { videoIds: ["id1",...] }
# Assist: POST {URL}/assist with { body, action, pollQuestion? } for post composer AI
NEXT_PUBLIC_CF_WORKER_URL=https://your-worker.your-subdomain.workers.dev

# Ollama (optional – local backup for Llama Vision, e.g. http://localhost:11434)
# Use for local dev or self-hosted vision; not used by deployed app
# NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434

# Only for GitHub Pages project site (e.g. username.github.io/SS-Tournaments)
# GITHUB_REPO=SS-Tournaments

# Stripe (for Pro, Elite, Clan Ultra subscriptions)
# NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_xxx
# NEXT_PUBLIC_STRIPE_ELITE_PRICE_ID=price_xxx
# NEXT_PUBLIC_STRIPE_CLAN_ULTRA_PRICE_ID=price_xxx

# Google OAuth (YouTube video picker)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# Meta (Messenger / Facebook Login)
# NEXT_PUBLIC_FACEBOOK_APP_ID=xxx
# FACEBOOK_APP_SECRET=xxx

# Google AdSense (when set, ad slots use AdSense)
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# For scripts/send-announcement.ts (Gmail mass announcements)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GMAIL_USER=smashhub@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
ANNOUNCEMENT_SUBJECT=SmashHub Announcement
